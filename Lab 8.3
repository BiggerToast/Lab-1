    MenuOptions::MenuOptions(){}
    
    void MenuOptions::printMenu() const {
    for (size_t i = 0; i < food.size(); ++i) {
        char optionLetter = static_cast<char>('A' + i);
        cout << optionLetter << ". " << food[i] << " - $" << price[i] << endl;
    }
    }
    
