    double MenuOptions::getPrice(char itemChar) const {
    char upperChar = toupper(static_cast<unsigned char>(itemChar));
    int index = upperChar - 'A';

    if (index >= 0 && index < static_cast<int>(food.size())) {
        cout << "Added " << food[index] << " ($" << price[index] << ")" << endl;
        return price[index];
    }

    cout << "Invalid item number." << endl;
    return 0.0;
    }

    
