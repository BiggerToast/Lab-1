#include <iostream>
#include <iomanip>
#include <fstream>
#include <string>
using namespace std;

void patient(ifstream &inFile, int numPatients);
int main()
{
    
    ifstream inFile("patients.txt");
    
    if(!inFile){
        cout << "no file detected" << endl;
        return 1;
    }
    int totalPatientsInFile;
    inFile >> totalPatientsInFile;
    
    int number;
    
    cout << "How many patients do you want process today: ";
    cin >> number;
    
    cout << endl << endl;
    
    
    if(number <= 0){
    cout << "No patients today" << endl;
    }
    else {
    patient(inFile, number);
    }
    
    cout << endl;
    cout << "thank you for using out system.";
    
    inFile.close();
    
    return 0;
}

void patient(ifstream &inFile, int numPatients){
    
    string FirstName, lastName;
    double weight;
    double height;
    double BMI;
    
    for (int i = 0; i <= numPatients; i++){
    
    while(inFile >> FirstName >> lastName >> weight >> height){
        
        string fullName = FirstName + " " + lastName;
    double heightInMeters = height / 100.0;
    BMI = weight / (heightInMeters * heightInMeters);
    
    cout << fullName <<endl;
    
    cout << fullName << " " << weight << " " <<height << endl;
    cout << fixed << setprecision(2);
    cout << fullName << "'s BMI is: " << BMI << endl;
    
    if (BMI >= 1 && BMI <= 18.5) {
        cout << "The BMI classification is underweight" << endl << endl;
    }
    else if (BMI >= 18.6 && BMI <= 24.9) {
        cout << "The BMI classification is normal " << endl << endl;
    }
    else if (BMI >= 25 && BMI <= 29.9) {
        cout << "The BMI classification is overweight" << endl << endl;
    }
    else {
        cout << "The BMI classification is Obese" << endl << endl;
        
    }
    cout << "(#" << i << ") Reached end of file early." << endl;
    break;
    }
    }
}
