            index[i] = "";
        }
    }
    
    bool searchIndex(string index[], string target, int searching){
        if (searching == 0){ //checks for the tartgeted index text
            for(int i = 0; i< max_word; i++){
                if(index[i] == target){
                    return true;
                }
            }
        }
    return false;
    }
    bool searchBinary(string index[], string target, int max_word) {
    int low = 0; // where binary takes place
    int high = high - 1;

    while (low <= high) {
        int mid = low + (high - low) / 2;

        if (index[mid] == target) {
            return true;
        }
        else if (index[mid] < target) {
            low = mid + 1;
        }
        else {
            high = mid - 1;
        }
    }
    return false;
    }
    
