void LoadDictionary(string index[], bool &stat){
    
    ifstream fin("dictionary_small.txt");
    
    if (!fin) {
        stat = true;
    } else {
    int t = 0;
    string text;
    
        while(t < max_word && fin >> text) {
          index[t] = text;
          t++;
        }
    fin.close();
        }
    }

    void initializeArray(string index[], int max_word){
        for (int i = 0; i < max_word; i++){
            index[i] = "";
        }
    }
    
    bool searchIndex(string index[], string target, int searching){
        if (searching == 0){
            for(int i = 0; i< max_word; i++){
                if(index[i] == target){
                    return true;
                }
            }
        }
    return false;
    }
    
