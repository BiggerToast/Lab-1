void patient(){
    string name;
    double weight;
    double height;
    double BMI;
    cout << ": ";
    cin.ignore();
    getline(cin, name);
    cout << "Enter weights in kilograms: ";
    cin >> weight;
    cout << "Enter height in centimeters: ";
    cin >> height;
    double heightInMeters = height / 100.0;
    BMI = weight / (heightInMeters * heightInMeters);
    
    cout << fixed << setprecision(2);
    cout << name << "'s BMI is: " << BMI << endl;
    
    if (BMI >= 1 && BMI <= 18.5) {
        cout << "The BMI classification is underweight" << endl;
    }
    else if (BMI >= 18.6 && BMI <= 24.9) {
        cout << "The BMI classification is normal " << endl;
    }
    else if (BMI >= 25 && BMI <= 29.9) {
        cout << "The BMI classification is overweight" << endl;
    }
    else {
        cout << "The BMI classification is Obese" << endl;
    }
    
}
